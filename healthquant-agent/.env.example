# ============================================================
# HealthQuant Agent — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# MongoDB Atlas — primary database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB_NAME=healthquant

# MongoDB Voyage AI — for feature embeddings
# Get from: Atlas UI → AI Models → Create model API key
VOYAGE_API_KEY=<your-voyage-model-api-key>
VOYAGE_MODEL=voyage-3-large        # 1024 dims; alternative: voyage-finance-2

# MongoDB MCP Server — for agent tool integration
MDB_MCP_CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/healthquant
MDB_MCP_READ_ONLY=false            # set true for production/demo safety

# Google Cloud — for Gemini ADK
# Lowest-cost local setup: get an API key from https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# For Vertex AI instead: set GOOGLE_GENAI_USE_VERTEXAI=true, the project/location,
# and use gcloud auth application-default login (or an existing service identity).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json

# Optional: SEC EDGAR API key (free tier available at sec-api.io)
SEC_API_KEY=<your-key-or-leave-blank>

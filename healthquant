#!/bin/sh
# Repository-local launcher: does not install packages or alter shell settings.
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
python_bin="$project_dir/.venv/bin/python"
if [ ! -x "$python_bin" ]; then
    printf '%s\n' 'Missing .venv/bin/python. Create the project environment and install requirements first.' >&2
    exit 1
fi
cd "$project_dir/healthquant-agent" || exit 1
exec "$python_bin" -m agent.cli "$@"
